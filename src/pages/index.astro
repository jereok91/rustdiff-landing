---
import '../styles/global.css';
import Layout from '../layouts/Layout.astro';

const shortcuts = [
  { key: 'Ctrl+O', action: 'Open file in left panel' },
  { key: 'Ctrl+Shift+O', action: 'Open file in right panel' },
  { key: 'Ctrl+Enter', action: 'Force compare' },
  { key: 'Ctrl+S', action: 'Save session to history' },
  { key: 'Ctrl+E', action: 'Export result as .txt' },
  { key: 'Ctrl+Shift+F', action: 'Pretty-print both panels' },
  { key: 'Ctrl+H', action: 'Toggle history panel' },
  { key: 'Ctrl+F', action: 'Search in editor' },
];

const features = [
  {
    title: 'Semantic Diff',
    description: 'Key-by-key JSON comparison, node-by-node XML analysis with attributes and text differentiation.',
    icon: '🔍'
  },
  {
    title: 'Side-by-Side Editors',
    description: 'Split view with syntax highlighting and automatic pretty-print for easy comparison.',
    icon: '📝'
  },
  {
    title: 'Inline Highlighting',
    description: 'Added, removed, and changed items highlighted directly in the editors for instant visual feedback.',
    icon: '🎨'
  },
  {
    title: 'Difference Table',
    description: 'Filterable table with click-to-jump navigation to exact locations in your documents.',
    icon: '📊'
  },
  {
    title: 'Export Options',
    description: 'Export to plain text (.txt) or styled HTML for sharing or archiving your comparisons.',
    icon: '📤'
  },
  {
    title: 'Session History',
    description: 'SQLite-backed history with pagination and search. Never lose your comparison work.',
    icon: '📚'
  },
  {
    title: 'System Theme',
    description: 'Dark mode follows your system preferences automatically. Native GTK4 + Libadwaita look.',
    icon: '🌓'
  },
  {
    title: 'Zoom Support',
    description: 'Ctrl + mouse wheel zoom on both editors. Customize your view for any screen size.',
    icon: '🔎'
  },
];

const installMethods = [
  {
    title: 'Flatpak (Recommended)',
    code: `flatpak install flathub com.digitalgex.RustDiff
flatpak run com.digitalgex.RustDiff`,
    note: 'Best for desktop users on any Linux distribution'
  },
  {
    title: 'APT Repository',
    code: `curl -fsSL https://jereok91.github.io/rustdiff/KEY.gpg | sudo tee /usr/share/keyrings/rustdiff-archive-keyring.gpg >/dev/null
echo "deb [arch=amd64 signed-by=/usr/share/keyrings/rustdiff-archive-keyring.gpg] https://jereok91.github.io/rustdiff stable main" | sudo tee /etc/apt/sources.list.d/rustdiff.list >/dev/null
sudo apt update && sudo apt install rustdiff`,
    note: 'For Debian/Ubuntu-based systems'
  },
  {
    title: 'Cargo',
    code: `cargo install rustdiff`,
    note: 'For Rust users with existing toolchain'
  },
];
---

<Layout title="RustDiff — Semantic JSON & XML Diff Tool">
  <!-- Navigation -->
  <nav class="nav">
    <div class="container-custom flex items-center justify-between h-16">
      <div class="flex items-center gap-3">
        <img src="/favicon.svg" alt="RustDiff" class="w-8 h-8" />
        <span class="text-xl font-bold" style="color: var(--color-text);">RustDiff</span>
      </div>
      <div class="hidden md:flex items-center gap-8">
        <a href="#features" class="nav-link">Features</a>
        <a href="#installation" class="nav-link">Installation</a>
        <a href="#shortcuts" class="nav-link">Shortcuts</a>
        <a href="https://github.com/jereok91/rustdiff" target="_blank" class="btn-secondary text-sm py-2 px-4">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
      </div>
      <div class="flex items-center gap-2">
        <button id="theme-toggle" aria-label="Toggle theme" class="icon-btn">
          <svg id="sun-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg id="moon-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
        <button id="mobile-menu-toggle" aria-label="Toggle menu" class="icon-btn md:hidden">
          <svg id="menu-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden mobile-menu">
      <div class="container-custom py-4 flex flex-col gap-4">
        <a href="#features" class="nav-link">Features</a>
        <a href="#installation" class="nav-link">Installation</a>
        <a href="#shortcuts" class="nav-link">Shortcuts</a>
        <a href="https://github.com/jereok91/rustdiff" target="_blank" class="btn-secondary text-sm py-2 px-4 w-fit">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="py-20 md:py-32">
    <div class="container-custom text-center">
      <div class="version-badge mb-6">
        <span class="pulse-dot"></span>
        v0.1.8 — Now with SQL support
      </div>
      <h1 class="hero-title mb-6">
        Semantic diff for
        <span class="text-primary">JSON</span>,
        <span class="text-primary">XML</span> & 
        <span class="text-primary">SQL</span>
      </h1>
      <p class="text-lg md:text-xl max-w-2xl mx-auto mb-10" style="color: var(--color-muted);">
        Native GTK4 desktop application with side-by-side editors, syntax highlighting, and visual difference navigation.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#installation" class="btn-primary">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          Install RustDiff
        </a>
        <a href="https://github.com/jereok91/rustdiff" target="_blank" class="btn-secondary">
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- Screenshot -->
  <section class="py-8">
    <div class="container-custom">
      <div class="screenshot-container">
        <img 
          src="https://raw.githubusercontent.com/jereok91/rustdiff/main/data/screenshots/main.png" 
          alt="RustDiff main interface comparing JSON documents"
          class="w-full rounded-xl"
        />
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-20 scroll-mt-20">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="section-title">Features</h2>
        <p class="mt-2" style="color: var(--color-muted);">Everything you need for semantic document comparison</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {features.map(feature => (
          <div class="card">
            <div class="text-3xl mb-4">{feature.icon}</div>
            <h3 class="text-lg font-semibold mb-2" style="color: var(--color-text);">{feature.title}</h3>
            <p class="text-sm" style="color: var(--color-muted);">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Installation Section -->
  <section id="installation" class="py-20" style="background-color: var(--color-surface);">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="section-title">Installation</h2>
        <p class="mt-2" style="color: var(--color-muted);">Choose the method that works best for your system</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {installMethods.map((method, index) => (
          <div class="card flex flex-col">
            <div class="flex items-center gap-3 mb-4">
              <span class="step-badge">{index + 1}</span>
              <h3 class="text-lg font-semibold" style="color: var(--color-text);">{method.title}</h3>
            </div>
            <pre class="code-block"><code>{method.code}</code></pre>
            <p class="text-xs" style="color: var(--color-muted);">{method.note}</p>
          </div>
        ))}
      </div>
      <div class="mt-12 text-center">
        <p class="text-sm" style="color: var(--color-muted);">
          For other installation methods, see the 
          <a href="https://github.com/jereok91/rustdiff" target="_blank" class="text-primary hover:underline">GitHub README</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Shortcuts Section -->
  <section id="shortcuts" class="py-20 scroll-mt-20">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="section-title">Keyboard Shortcuts</h2>
        <p class="mt-2" style="color: var(--color-muted);">Work faster with these keyboard shortcuts</p>
      </div>
      <div class="max-w-2xl mx-auto">
        <div class="card">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {shortcuts.map(shortcut => (
              <div class="shortcut-row">
                <span class="text-sm" style="color: var(--color-muted);">{shortcut.action}</span>
                <kbd class="kbd">{shortcut.key}</kbd>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Available Platforms -->
  <section class="py-20" style="background-color: var(--color-surface);">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="section-title">Available On</h2>
        <p class="mt-2" style="color: var(--color-muted);">Get RustDiff from your preferred platform</p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-8">
        <a href="https://crates.io/crates/rustdiff" target="_blank" class="platform-link">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.328 6.41a7.5 7.5 0 0 0-7.24-5.69l-.87.04-.58-.04-.59.04-.87-.04C5.34 0 0 5.34 0 11.24c0 4.62 2.97 8.66 7.24 10.26l.87-.04.58.04.59-.04.87.04c5.9.53 10.88-4.1 10.88-9.97 0-2.93-1.19-5.58-3.13-7.58zM5.655 16.12c-.72.36-1.54.57-2.42.57-2.34 0-4.32-1.35-5.04-3.26-.36-.95-.18-1.98.36-2.82l.18-.27 1.26.54-.18.27c-.36.63-.45 1.35-.27 2.01.45 1.62 2.04 2.79 3.87 2.79.63 0 1.26-.09 1.8-.27l.27-.18 1.26.54-.27.18c-.54.27-1.17.36-1.8.36zm10.89-5.76l-.09.06c-.63.36-1.35.54-2.07.54-2.34 0-4.32-1.35-5.04-3.26-.36-.95-.18-1.98.36-2.82l.18-.27 1.26.54-.18.27c-.36.63-.45 1.35-.27 2.01.45 1.62 2.04 2.79 3.87 2.79.63 0 1.26-.09 1.8-.27l.27-.18 1.26.54-.27.18c-.54.27-1.17.36-1.8.36-.72 0-1.44-.18-2.07-.54l-.09-.06 1.35-.9 1.35.9zm2.16-2.79l1.26.54-.18.27c-.36.63-.45 1.35-.27 2.01.45 1.62 2.04 2.79 3.87 2.79.63 0 1.26-.09 1.8-.27l.27-.18 1.26.54-.27.18c-.54.27-1.17.36-1.8.36-.72 0-1.44-.18-2.07-.54l-.09-.06 1.35-.9 1.35.9z"/>
          </svg>
          <span class="font-medium" style="color: var(--color-text);">crates.io</span>
        </a>
        <a href="https://flathub.org/apps/com.digitalgex.RustDiff" target="_blank" class="platform-link">
          <svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 2.4c5.27 0 9.6 4.33 9.6 9.6 0 5.27-4.33 9.6-9.6 9.6-5.27 0-9.6-4.33-9.6-9.6 0-5.27 4.33-9.6 9.6-9.6z"/>
          </svg>
          <span class="font-medium" style="color: var(--color-text);">Flathub</span>
        </a>
        <a href="https://jereok91.github.io/rustdiff/" target="_blank" class="platform-link">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
          </svg>
          <span class="font-medium" style="color: var(--color-text);">APT Repository</span>
        </a>
        <a href="https://github.com/jereok91/rustdiff" target="_blank" class="platform-link">
          <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          <span class="font-medium" style="color: var(--color-text);">GitHub</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="py-10 border-t" style="border-color: var(--color-border);">
    <div class="container-custom">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <img src="/favicon.svg" alt="RustDiff" class="w-6 h-6" />
          <span class="font-semibold" style="color: var(--color-text);">RustDiff</span>
          <span style="color: var(--color-muted);">— Built with Rust & GTK4</span>
        </div>
        <p class="text-sm" style="color: var(--color-muted);">
          GPL-3.0-or-later · © 2024-{new Date().getFullYear()} digitalgex
        </p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Navigation */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--color-border);
    background-color: color-mix(in srgb, var(--color-surface) 80%, transparent);
    backdrop-filter: blur(12px);
  }

  .nav-link {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--color-primary);
    opacity: 1;
  }

  .icon-btn {
    padding: 0.5rem;
    border-radius: 0.5rem;
    background-color: var(--color-border);
    transition: background-color 0.2s;
    color: var(--color-text);
  }

  .icon-btn:hover {
    background-color: color-mix(in srgb, var(--color-border) 80%, var(--color-primary) 20%);
  }

  /* Hero */
  .hero-title {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
  }

  @media (min-width: 640px) {
    .hero-title {
      font-size: 3rem;
    }
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 3.75rem;
    }
  }

  .text-primary {
    color: var(--color-primary);
  }

  /* Screenshot */
  .screenshot-container {
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: 0 25px 50px -12px rgb(0 0 0 / 0.25);
  }

  /* Shortcuts */
  .shortcut-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .shortcut-row:last-child {
    border-bottom: none;
  }

  /* Step badge */
  .step-badge {
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background-color: var(--color-primary);
    color: #000;
    font-weight: 700;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Dark mode adjustments for icons */
  .dark #sun-icon {
    display: none;
  }

  .dark #moon-icon {
    display: block;
  }

  :not(.dark) #sun-icon {
    display: block;
  }

  :not(.dark) #moon-icon {
    display: none;
  }
</style>

<script>
  // Theme toggle functionality
  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');
  
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Mobile menu toggle
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  mobileMenuToggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden', !isOpen);
    closeIcon?.classList.toggle('hidden', isOpen);
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>